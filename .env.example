# Copy to .env and adjust for your environment.
# All variables are prefixed KAIZEN_ and map to app/config.py::Settings

KAIZEN_ENVIRONMENT=development
KAIZEN_HOST=0.0.0.0
KAIZEN_PORT=8000

# Comma-separated list — never use "*" in production with credentials enabled.
KAIZEN_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

KAIZEN_MAX_UPLOAD_MB=25
KAIZEN_MIN_TRAINING_ROWS=120
KAIZEN_LOG_LEVEL=INFO
